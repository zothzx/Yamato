-- ====================== ESP ======================
local function limparESP()
	for _, h in pairs(highlights) do
		pcall(function() if h then h:Destroy() end end)
	end
	highlights = {}
end

local function aplicarESP(plr)
	if plr == player then return end
	local char = plr.Character
	if not char then return end
	if highlights[plr] and highlights[plr].Parent == char then return end
	if highlights[plr] then
		pcall(function() highlights[plr]:Destroy() end)
		highlights[plr] = nil
	end

	local h = Instance.new("Highlight")
	h.FillColor = Config.Colors.Accent
	h.OutlineColor = Color3.fromRGB(255, 255, 255)
	h.FillTransparency = 0.6
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = char
	highlights[plr] = h
end

local function setESP(on)
	espOn = on
	btnESP.BackgroundColor3 = on and Config.Colors.Success or Config.Colors.Background3
	if on then
		for _, plr in ipairs(Players:GetPlayers()) do
			aplicarESP(plr)
		end
	else
		limparESP()
	end
end

btnESP.MouseButton1Click:Connect(function()
	setESP(not espOn)
end)

task.spawn(function()
	while true do
		task.wait(1.2)
		if espOn then
			for _, plr in ipairs(Players:GetPlayers()) do
				aplicarESP(plr)
			end
		end
	end
end)

for _, plr in ipairs(Players:GetPlayers()) do
